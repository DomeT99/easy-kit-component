{
  "name": "easy-kit-component",
  "type": "module",
  "description": "Simple component kit for Vue 3",
  "version": "0.2.0",
  "author": "Domenico Tenace <domenicotenace99@gmail.com> (https://linktr.ee/domenicotenace)",
  "repository": {
    "type": "git",
    "url": "https://github.com/DomeT99/easy-kit.git",
    "directory": "https://github.com/DomeT99/easy-kit/blob/master/package.json"
  },
  "license": "MIT",
  "keywords": [
    "library",
    "vue",
    "javascript",
    "typescript",
    "component"
  ],
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "scripts": {
    "build": "vue-tsc && vite build",
    "test": "vitest --dom",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@orama/plugin-vitepress": "^3.1.18",
    "happy-dom": "^20.9.0",
    "vite-plugin-dts": "^5.0.0",
    "vue": "^3.4.31"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitepress": "^1.2.3",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  },
  "packageManager": "pnpm@10.28.1"
}
